rules_version = '2';

// Who can do what:
//   • Everyone (no login): read games, read PUBLISHED strategies.
//   • Admin (one UID): read and write everything, including drafts and notes.
//   • Anyone else, signed in or not: nothing else.
//
// Each game has exactly one strategy page: strategies/{gameId}.
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep in sync with src/lib/admin.ts and storage.rules.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'coSz3U5jiVaLysbqclMsuXPGAqi2';
    }

    function optionalString(d, field, maxLen) {
      return !(field in d) || d[field] == null || (d[field] is string && d[field].size() <= maxLen);
    }

    function validGame(d) {
      return d.keys().hasOnly(['name', 'nameLower', 'manufacturer', 'year', 'photo', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && optionalString(d, 'manufacturer', 100)
        && (!('year' in d) || d.year == null || (d.year is int && d.year >= 1930 && d.year <= 2100))
        && (!('photo' in d) || d.photo == null || d.photo is map);
    }

    function validStrategy(d, strategyId) {
      return d.keys().hasOnly(['gameId', 'gameName', 'body', 'excerpt', 'photos', 'tags', 'status',
                               'createdAt', 'updatedAt', 'publishedAt'])
        && d.keys().hasAll(['gameId', 'status'])
        // One strategy per game: the strategy's id must be its game's id.
        && d.gameId == strategyId
        && d.status in ['draft', 'published']
        && optionalString(d, 'gameName', 100)
        && optionalString(d, 'excerpt', 500)
        && (!('body' in d) || (d.body is string && d.body.size() <= 900000))
        // 'tags' is no longer used, but pages saved before it was removed still
        // have the field, so it stays allowed or those pages couldn't be edited.
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20))
        && (!('photos' in d) || (d.photos is list && d.photos.size() <= 100));
    }

    function validNote(d) {
      return d.keys().hasOnly(['text', 'photoIds', 'createdAt', 'updatedAt', 'mergedAt'])
        && d.text is string && d.text.size() <= 100000
        && (!('photoIds' in d) || (d.photoIds is list && d.photoIds.size() <= 100));
    }

    match /games/{gameId} {
      allow read: if true;
      allow create, update: if isAdmin() && validGame(request.resource.data);
      allow delete: if isAdmin();
    }

    match /strategies/{strategyId} {
      // Public queries must filter on status == 'published' or they are rejected.
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update: if isAdmin() && validStrategy(request.resource.data, strategyId);
      allow delete: if isAdmin();

      // Raw Quick Capture notes are never public, even for published strategies.
      match /notes/{noteId} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin() && validNote(request.resource.data);
      }
    }

    // Anything not matched above is denied by default.
  }
}
